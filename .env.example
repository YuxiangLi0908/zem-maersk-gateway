# Internal gateway auth
INTERNAL_API_AUTH_KEY=change-me

# Rating API (Pilot)
MAERSK_API_KEY=change-me
LOCATION_ID=109775
ADDRESS_ID=34099563
TARIFF_HEADER_ID=33591

# Shipment API (Maersk MGF)
# Consumer key sent as header `Consumer-Key`
MAERSK_CONSUMER_KEY=change-me
SHIPMENT_API_URL=https://api-stage.maersk.com/mgf/public-gateway/shipments

# Defaults injected by the gateway when client omits them
SHIPMENT_TARIFF_CODE=ZEM
SHIPMENT_LOCATION_ID=109775
SHIPMENT_SERVICE_CODE=BA
SHIPMENT_CONTROL_STATION=GOP
